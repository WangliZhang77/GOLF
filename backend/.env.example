# 后端环境变量示例，复制为 .env 后按需修改
APP_NAME=NZ-Golf-CRM
APP_ENV=local
DEBUG=true

# 数据库（本地 docker-compose 默认值）
DATABASE_URL=postgresql+psycopg://golf:golf@localhost:5432/golf_crm

# JWT（Phase 1 会用到，Phase 0 先占位）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 允许的跨域来源（两个前端）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
